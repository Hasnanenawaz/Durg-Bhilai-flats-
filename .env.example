# ── Site ───────────────────────────────────────────────
NEXT_PUBLIC_SITE_URL=https://durgbhilaiflats.in
NEXT_PUBLIC_SITE_NAME=Durg Bhilai Flats & Flatmates
# Your WhatsApp number for the floating help button (country code, no +)
NEXT_PUBLIC_SUPPORT_WHATSAPP=919999999999
NEXT_PUBLIC_SUPPORT_EMAIL=hello@durgbhilaiflats.in

# ── Session ────────────────────────────────────────────
# Long random string. Generate with: openssl rand -base64 48
# The site refuses to start in production with this placeholder value.
SESSION_SECRET=change-me-to-a-long-random-string

# Phone numbers that get admin access (10 digits, comma separated)
ADMIN_PHONES=9999999999
# Passcode for /admin-login. Logs in as the first number in ADMIN_PHONES. Admin login is off while this is empty.
ADMIN_PASSCODE=

# true = new listings go live immediately, false = admin approves first
LISTING_AUTO_APPROVE=false

# ── Supabase (database + image storage) ────────────────
# Leave empty to run locally with a JSON file in .data/ (dev only; the build fails on Vercel without them)
NEXT_PUBLIC_SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_BUCKET=property-images

# ── Google Places (search box suggestions) ─────────────
# Server only, never NEXT_PUBLIC_. Empty = suggestions come from our own list of areas in lib/locations.js.
# Restrict the key to Places API (New) and set a daily quota cap: it can't have a referrer restriction.
GOOGLE_PLACES_API_KEY=

# ── MSG91 (OTP SMS) ────────────────────────────────────
# MSG91_AUTHKEY is server only, never NEXT_PUBLIC_. Remove these to go back to Firebase.
MSG91_AUTHKEY=
# OTP API (needs DLT and the otp_events table from supabase/schema.sql). Used if set, even with the widget set up.
MSG91_OTP_TEMPLATE_ID=
# OTP Widget (default template, no DLT wait). Used when the template above is empty. Both reach the browser by design.
MSG91_WIDGET_ID=
MSG91_WIDGET_TOKEN=

# ── Firebase Phone Auth (OTP SMS) ──────────────────────
# Set all four, or leave these and MSG91 empty to use dev OTP mode (code shown on screen, never in production)
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# Set true only for a private staging/demo deploy or a local test run without Firebase.
# The code is shown on screen, so anyone can log in as any number. Always off on Vercel production.
ALLOW_DEV_OTP=false
