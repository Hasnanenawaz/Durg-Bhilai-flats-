# ── Site ───────────────────────────────────────────────
NEXT_PUBLIC_SITE_URL=https://durgbhilaiflats.in
NEXT_PUBLIC_SITE_NAME=Durg Bhilai Flats & Flatmates
# Your WhatsApp number for the floating help button (country code, no +)
NEXT_PUBLIC_SUPPORT_WHATSAPP=919999999999
NEXT_PUBLIC_SUPPORT_EMAIL=hello@durgbhilaiflats.in

# ── Session ────────────────────────────────────────────
# Long random string. Generate with: openssl rand -base64 48
SESSION_SECRET=change-me-to-a-long-random-string

# Phone numbers that get admin access (10 digits, comma separated)
ADMIN_PHONES=9999999999

# true = new listings go live immediately, false = admin approves first
LISTING_AUTO_APPROVE=false

# ── Supabase (database + image storage) ────────────────
# Leave empty to run locally with a JSON file in .data/ (dev only)
NEXT_PUBLIC_SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_BUCKET=property-images

# ── Firebase Phone Auth (OTP SMS) ──────────────────────
# Leave empty to use dev OTP mode (code shown on screen, never in production)
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# Set true only for a staging/demo deploy without Firebase
ALLOW_DEV_OTP=false
